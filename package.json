{
  "name": "gyoumu-log-kintai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:rules": "firebase emulators:exec --only firestore,auth,storage 'vitest run --config vitest.rules.config.ts'",
    "emulators": "firebase emulators:start --project demo-kintai --export-on-exit=.firebase-data",
    "seed": "node scripts/seed-emulator.mjs",
    "bootstrap:production": "node scripts/bootstrap-production.mjs",
    "functions:build": "npm --prefix functions run build",
    "build:all": "npm run build && npm run functions:build"
  },
  "dependencies": {
    "firebase": "^11.10.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "firebase-admin": "^13.0.2",
    "firebase-tools": "^14.12.1",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^2.1.8"
  }
}
